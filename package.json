{
  "name": "windows-debug-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Windows Debug Bridge server and portable CLI",
  "type": "commonjs",
  "bin": { "wdb": "src/cli.js" },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:client": "node --test tests/cli.test.js tests/macos-client.test.js tests/client-portable.test.js tests/transport-events.test.js",
    "build:macos": "sh scripts/build-client-macos.sh",
    "build:npm": "node scripts/build-cli-npm.js",
    "start": "node src/server.js",
    "helper": "node src/helper.js"
  },
  "engines": { "node": ">=24.15.0 <25" }
}
